# Credenciais da API DATATEM (gerenciamento de SIM cards M2M/IoT).
# Copie este arquivo para .env e preencha com os dados da sua conta.
DATATEM_USER=seu_usuario_do_portal
DATATEM_PASSWORD=sua_senha
DATATEM_CLIENT_ID=seu_client_id
DATATEM_CLIENT_SECRET=seu_client_secret
DATATEM_API_URL=https://app-gateway.brcaptura.com.br
